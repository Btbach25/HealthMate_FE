# Dev — api-gateway (nginx :8080). Flutter Web: dùng localhost để khớp origin (localhost:<port>).
BASE_URL=http://192.168.10.131:8080
# Nếu bắt buộc gọi 127.0.0.1:8080 thì chạy web cùng host, ví dụ:
# flutter run -d chrome --web-hostname=127.0.0.1 --web-port=61837
# và đặt BASE_URL=http://127.0.0.1:8080
# Điện thoại USB: adb reverse tcp:8080 tcp:8080
# Wi‑Fi: IP LAN máy chạy Docker, ví dụ BASE_URL=http://192.168.1.x:8080
