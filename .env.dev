# Dev — api-gateway trên cùng máy (Chrome: dùng 127.0.0.1 tránh lỗi localhost/IPv6 trên Windows)
BASE_URL=http://127.0.0.1:8080
# BASE_URL=http://localhost:8080
# Điện thoại USB: adb reverse tcp:8080 tcp:8080 rồi giữ 127.0.0.1 hoặc localhost
# Wi‑Fi: IP LAN máy chạy Docker, ví dụ BASE_URL=http://192.168.1.x:8080
