# ---------------------------------------------------------------------------
# Mẫu cấu hình môi trường của HealthMate FE.
#
#   cp .env.example .env      # rồi điền giá trị thật
#
# File `.env` được khai báo là asset trong `pubspec.yaml` nên hoạt động cả trên
# Web. Sau khi sửa `.env` phải **hot-restart** (không phải hot-reload) vì asset
# chỉ được đọc một lần lúc khởi động.
# ---------------------------------------------------------------------------

# --- Bắt buộc -------------------------------------------------------------

# TRẠNG THÁI: backend hiện đang TẮT và tên miền đã bị gỡ, nên chưa có giá trị
# thật để điền. Cứ để trống và chạy chế độ demo (DEMO_MODE=true) cho tới khi
# backend được dựng lại — xem mục "Kết nối lại backend" trong README.
#
# URL gốc của api-gateway, KHÔNG có dấu "/" ở cuối.
#   - Backend đã deploy : http://<ip-hoac-domain>
#   - Chạy local        : http://localhost:8080
#   - Android emulator  : http://10.0.2.2:8080   (localhost là chính máy ảo)
#   - Thiết bị Android thật qua USB: chạy `adb reverse tcp:8080 tcp:8080`
#     (`make adb-reverse`) rồi dùng http://localhost:8080
# Bỏ trống thì app tự suy ra endpoint local theo nền tảng đang chạy.
BASE_URL=

# --- Google Sign-In -------------------------------------------------------

# OAuth 2.0 **Web client ID** lấy ở Google Cloud Console →
# APIs & Services → Credentials → OAuth 2.0 Client IDs → Web application.
# Dùng làm `clientId` trên Web và `serverClientId` trên Android/iOS để backend
# verify được idToken. Bỏ trống thì nút "Đăng nhập với Google" sẽ bị vô hiệu.
GOOGLE_CLIENT_ID=

# --- Chế độ demo ----------------------------------------------------------

# true  → chạy hoàn toàn bằng mock data trong lib/data/mock_data/, không gọi API.
#         Dùng để demo/onboarding contributor mới khi chưa có backend.
# false → gọi API thật tại BASE_URL.
# Có thể override lúc chạy: flutter run --dart-define=DEMO_MODE=true
DEMO_MODE=false

# --- Firebase (chỉ Web) ---------------------------------------------------

# Android/iOS đọc cấu hình từ google-services.json / GoogleService-Info.plist,
# KHÔNG cần điền các biến dưới đây.
# Web bắt buộc truyền FirebaseOptions thủ công; thiếu bất kỳ biến bắt buộc nào
# thì app vẫn chạy nhưng không có push notification.
# Lấy tại: Firebase Console → Project settings → Your apps → Web app → SDK setup.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
# Web Push certificate key pair (Cloud Messaging → Web configuration).
FIREBASE_VAPID_KEY=
